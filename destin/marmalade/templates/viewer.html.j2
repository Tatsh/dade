{#
  Standalone WebGL model viewer.

  Rendered by marmalade.viewer.obj_to_html. The data-injection bits ({{ title }},
  {{ nv }}, {{ nf }} and the POS/IDX arrays) are templated; the render loop is
  embedded verbatim from templates/viewer.js via the trusted `webgl_js` variable.
-#}
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{ title }} — model viewer</title>
    <style>
      html, body {
        margin: 0;
        height: 100%;
        overflow: hidden;
        background: #0e1014;
        font: 13px system-ui, sans-serif;
        color: #cfd6e0;
      }
      #c {
        display: block;
        width: 100vw;
        height: 100vh;
        cursor: grab;
      }
      #c:active {
        cursor: grabbing;
      }
      #hud {
        position: fixed;
        left: 12px;
        top: 10px;
        pointer-events: none;
        line-height: 1.5;
        text-shadow: 0 1px 2px #000;
      }
      #hud b {
        color: #fff;
      }
      #hint {
        position: fixed;
        right: 12px;
        bottom: 10px;
        opacity: 0.6;
        pointer-events: none;
      }
    </style>
  </head>
  <body>
    <canvas id="c"></canvas>
    <div id="hud">
      <b>{{ title }}</b><br>
      {{ nv }} verts · {{ nf }} tris
    </div>
    <div id="hint">drag = orbit · wheel = zoom · dbl-click = reset</div>
    <script>
      const POS = {{ pos|tojson }}, IDX = {{ idx|tojson }};
    </script>
    <script>
      {{ webgl_js|safe }}
    </script>
  </body>
</html>
